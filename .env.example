# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; this template is not.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where enquiries are delivered.
#
# IMPORTANT while using the onboarding@resend.dev sandbox sender below:
# Resend only allows delivery to the email that owns the Resend account, and it
# matches CASE-SENSITIVELY. Use the exact lowercase address Resend shows you,
# or sends fail with a 403 validation_error.
CONTACT_TO_EMAIL=chakravarthynaik101@gmail.com

# Verified sender. Until you verify your own domain in Resend, use their sandbox:
#   Portfolio <onboarding@resend.dev>
# After verifying a domain at resend.com/domains you can switch to e.g.
#   Portfolio <hello@yourdomain.com>
# which also lifts the single-recipient restriction above.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
